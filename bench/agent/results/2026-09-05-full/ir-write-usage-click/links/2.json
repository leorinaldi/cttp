  "final_text": "Fixed in `src/click/formatting.py:167`: `write_usage` now short-circuits when `args` is empty, writing `usage_prefix.rstrip()` (indent + caller's verbatim prefix + prog, no trailing space) instead of passing an empty string through `wrap_text`, which dropped the `initial_indent` and left only a blank line. Non-empty args take the unchanged wrapping paths.\n\n`python -m pytest -q -o pythonpath=src tests/test_formatting.py` \u2014 27 passed.",
  "grade": {
    "passed": true,
    "returncode": 0,
    "timed_out": false,
    "output": "...................................                                      [100%]\n35 passed in 0.16s\n",
    "diff": "diff --git a/src/click/formatting.py b/src/click/formatting.py\nindex d9075ca..3b9cbbf 100644\n--- a/src/click/formatting.py\n+++ b/src/click/formatting.py\n@@ -164,7 +164,11 @@ class HelpFormatter:\n         usage_prefix = f\"{prefix:>{self.current_indent}}{prog} \"\n         text_width = self.width - self.current_indent\n \n-        if text_width >= (term_len(usage_prefix) + 20):\n+        if not args.strip():\n+            # There are no arguments, so only write the prefix and the program\n+            # name, without the separating trailing space.\n+            self.write(usage_prefix.rstrip())\n+        elif text_width >= (term_len(usage_prefix) + 20):\n             # The arguments will fit to the right of the prefix.\n             indent = \" \" * term_len(usage_prefix)\n             self.write(\n",
